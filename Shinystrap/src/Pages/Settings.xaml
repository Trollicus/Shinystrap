<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
      x:Class="Shinystrap.Pages.Settings"
      mc:Ignorable="d" 
      d:DesignWidth="695"
      d:DesignHeight="470"
      Title="Settings"
      Loaded="Settings_OnLoaded">

    <Grid>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,30,10,10" Background="Transparent">

                <TextBlock Text="Settings" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

                <Expander HorizontalContentAlignment="Stretch" Padding="16,12" Margin="0,0,0,10">
                    <Expander.Header>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="PhoneUpdate24"
                                           FontSize="24"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Check Update" FontWeight="SemiBold" />
                                <TextBlock Text="Checks whether Shinstrap has update" Foreground="White" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Current Version: "
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="White" Margin="10,0,428,0" />

                        <Button Grid.Column="1"
                                Content="Update"
                                Width="93"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="CheckUpdate_OnClick"/>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="White" Margin="120,0,323,0" x:Name="CurrentVersion"/>

                    </Grid>
                </Expander>

                <ui:CardControl Margin="0,0,0,10">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="PhoneUpdateCheckmark20" />
                    </ui:CardControl.Icon>

                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Auto Updater" FontWeight="SemiBold"/>
                            <TextBlock Text="Automatically checks Shinystrap for updates in the background." Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>

                    <ui:ToggleSwitch x:Name="UpdateToggle" VerticalAlignment="Center" Checked="UpdateToggle_Checked" Unchecked="UpdateToggle_Unchecked"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,10">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Bug24" />
                    </ui:CardControl.Icon>

                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Experimental Features" FontWeight="SemiBold"/>
                            <TextBlock Text="Experimental features. May contain bugs" Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>

                    <ui:ToggleSwitch x:Name="ExpFeaturesToggle" VerticalAlignment="Center" Checked="ExpFeatures_Checked" Unchecked="ExpFeatures_OnUnchecked"/>
                </ui:CardControl>
                <Expander HorizontalContentAlignment="Stretch" Padding="16,12">
                    <Expander.Header>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <ui:SymbolIcon Grid.Column="0"
                                Symbol="ArrowDownload24"
                                FontSize="24"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Initialize" FontWeight="SemiBold" />
                                <TextBlock Text="Roblox will be installed there." Foreground="White" FontSize="12"
                                    TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Path: "
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="White" Margin="10,0,498,0" />

                        <Button Grid.Column="1"
                            Content="Install"
                            Width="93"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="InstallRoblox_OnClick"/>

                        <TextBox x:Name="InstallationPath" Margin="50,5,10,0" VerticalAlignment="Top"/>

                    </Grid>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="403,10,0,10" Width="282"/>
    </Grid>
</Page>