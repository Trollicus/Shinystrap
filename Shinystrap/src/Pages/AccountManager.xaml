<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Shinystrap.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Shinystrap.Pages.AccountManager"
      mc:Ignorable="d"
      Title="AccountManager"      
      d:DesignWidth="695"
      d:DesignHeight="470">

    <Grid>
        <TextBlock Text="Account Manager" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,18,0,0"/>
        <TextBlock Text="Add accounts allowing to swiftly choose inbetween" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,47,0,0"/>

        <ui:Button Content="Add" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="113" Height="35" Margin="0,0,10,10" Click="AddButton_Click"/>
        <ui:Button Content="Remove" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="113" Height="35" Margin="0,0,128,10" Click="RemoveButton_Click"/>

        <ScrollViewer Margin="10,68,10,50" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AccountsList" ItemsSource="{Binding Accounts}" Height="342">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,0,0,10">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16" ClipToBounds="True" Margin="0,0,12,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ImageSource}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsSelected, Mode=TwoWay}" Unchecked="AccountSwitch_Unchecked" Checked="AccountSwitch_Checked"/>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Page>