<Page x:Class="Shinystrap.Pages.GameList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignWidth="695"
      d:DesignHeight="470"
      Title="GameList"
      Loaded="GameList_OnLoaded">

    <Grid>
        <TextBlock Text="Game List" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,18,0,0"/>
        <TextBlock Text="Quickly Join a game" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,47,0,0"/>

        <Grid Margin="356,27,31,0" VerticalAlignment="Top" Height="36">
            <ui:TextBox x:Name="SetChannel"
                PlaceholderText="Search here..."
                TextChanged="SearchGame_OnTextChanged">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
        </Grid>

        <ItemsControl x:Name="GameCards" Margin="10,68,10,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="16"
                            Background="#262626"
                            BorderBrush="#2D2D2D"
                            BorderThickness="1"
                            Width="209"
                            Margin="10,10,0,0">
                        <Grid>

                            <Border CornerRadius="10"
                                    ClipToBounds="True"
                                    Height="133"
                                    VerticalAlignment="Top"
                                    Margin="10,10,10,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ImageUrl}"
                                                Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="10,148,10,0"
                                       VerticalAlignment="Top" />

                            <TextBlock Text="{Binding Description}"
                                       FontSize="12"
                                       Foreground="#AAAAAA"
                                       TextWrapping="Wrap"
                                       Margin="10,172,10,0"
                                       VerticalAlignment="Top" />

                            <ui:Button Content="Join"
                                       Margin="0,210,0,10"
                                       VerticalAlignment="Top"
                                       Height="29"
                                       Width="130"
                                       HorizontalAlignment="Center"
                                       Tag="{Binding PlaceId}"
                                       Click="JoinButton_Click" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


    </Grid>
</Page>