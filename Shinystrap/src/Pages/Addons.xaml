<Page x:Class="Shinystrap.Pages.Addons"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignWidth="695"
      Title="Addons"
      Loaded="Addons_OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,30,10,30" Background="Transparent">

            <TextBlock Text="Tracking" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

            <ui:CardControl Margin="0,0,0,25">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="EyeTracking24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Server Location" FontWeight="SemiBold" />
                        <TextBlock Text="When in-game, shows the server location." Foreground="White" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IsActivityTrackingEnabled}" VerticalAlignment="Center"
                                 x:Name="TrackServerLocation" Checked="TrackServerLocation_OnChecked" Unchecked="TrackServerLocation_OnUnchecked" />
            </ui:CardControl>

            <TextBlock Text="Roblox Related" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

            <ui:CardControl Margin="0,0,0,10">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="UninstallApp24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Reinstall Roblox" FontWeight="SemiBold" />
                        <TextBlock Text="Installs Roblox freshly" Foreground="White" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="ReInstall" Foreground="White" Click="ReInstall_Click" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,10">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="BookmarkMultiple16" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Multi-Instance" FontWeight="SemiBold" />
                        <TextBlock Text="Enables roblox to get opened by more than one account." Foreground="White"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="MutexSwitch" VerticalAlignment="Center" Checked="RbxMutex_OnChecked"
                                 Unchecked="RbxMutex_OnUnchecked" />
            </ui:CardControl>

            <Expander HorizontalContentAlignment="Stretch" Padding="16,12" Margin="0,0,0,25">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Live24"
                                       FontSize="24"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Channel" FontWeight="SemiBold" />
                            <TextBlock Text="Choose deployment channel." Foreground="White" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBox x:Name="SetChannel" TextChanged="SetChannel_OnTextChanged" Grid.Column="2" Width="198" Margin="20,0,35,0" VerticalAlignment="Center"/>
                    </Grid>
                </Expander.Header>

                <Grid Height="55">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CurrentChannel"
                               Grid.Column="0"
                               VerticalAlignment="Top"
                               Foreground="White" Margin="0,8,0,0" />

                    <TextBlock Text="Version: "
                               Grid.Column="0"
                               VerticalAlignment="Top"
                               Foreground="White" Margin="0,28,488,0" />

                    <Button Grid.Column="1"
                            Content="Save"
                            Width="93"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="ChangeChanel_OnClick"/>

                    <TextBlock x:Name="WrittenChannel"
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Foreground="Gray" Margin="65,28,157,0" />
                </Grid>

            </Expander>

            <Expander HorizontalContentAlignment="Stretch" Padding="16,12" Margin="0,-15,0,25">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="FastAcceleration24"
                                       FontSize="24"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Player Sniper" FontWeight="SemiBold" />
                            <TextBlock Text="Snipe a roblox player of your choice." Foreground="White" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>


                    </Grid>
                </Expander.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="Player Id:" VerticalAlignment="Center" Foreground="White" Width="80" />
                            <TextBox x:Name="SnipeUsername" Width="200" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Place Id:" VerticalAlignment="Center" Foreground="White" Width="80" />
                            <TextBox x:Name="SnipePlaceId" Width="200" />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="SnipePlayerBtn" Grid.Column="1" Content="Snipe" VerticalAlignment="Top" Margin="0,48,0,0"
                            HorizontalAlignment="Center" Width="93" Click="SnipePlayer_OnClick"/>
                </Grid>
            </Expander>

            <Expander HorizontalContentAlignment="Stretch" Padding="16,12" Margin="0,-15,0,25">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <ui:SymbolIcon Grid.Column="0"
                           Symbol="Fps12020"
                           FontSize="24"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Framerate Limit" FontWeight="SemiBold" />
                            <TextBlock Text="Modify your framerate limits." Foreground="White" FontSize="12"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>


                    </Grid>
                </Expander.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="Current Cap:" VerticalAlignment="Center" Foreground="White" Width="90" />
                            <TextBlock Text="Current_FPS" x:Name="CurrentFPS"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Value:" VerticalAlignment="Center" Foreground="White" Width="90" />
                            <TextBox Width="200" x:Name="SetFPSValue" />
                        </StackPanel>
                    </StackPanel>

                    <Button  Grid.Column="1" Content="Save" VerticalAlignment="Top" Margin="0,48,0,0" HorizontalAlignment="Center" Width="93" Click="SaveFPSLimit_OnClick" />
                </Grid>
            </Expander>

            <Expander HorizontalContentAlignment="Stretch" Padding="16,12" Margin="0,-15,0,25">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Fire24"
                                       FontSize="24"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Block Roblox Servers" FontWeight="SemiBold" />
                            <TextBlock Text="Creates a Firewall rule that blocks roblox's server address. ( Separate IP's with new line )" Foreground="White" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>


                    </Grid>
                </Expander.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="Rule Name:" VerticalAlignment="Center" Foreground="White" Width="90" />
                            <TextBox Width="200"  x:Name="RuleName"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="IP Addresses: " Foreground="White" Width="90" />
                            <TextBox x:Name="IpList" Width="200" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Create Rule" VerticalAlignment="Top" Margin="0,102,0,0"
                            HorizontalAlignment="Center" Width="110" Click="CreateFirewallRule_OnClick"/>
                </Grid>
            </Expander>

            <Expander x:Name="ExistingRuleExpander" HorizontalContentAlignment="Stretch" Padding="16,12" Margin="0,-15,0,25">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <ui:SymbolIcon Grid.Column="0"
                            Symbol="Edit24"
                            FontSize="24"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Edit Existing Rule" FontWeight="SemiBold" />
                            <TextBlock Text="Edit's Existing rule" Foreground="White" FontSize="12"
                            TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>


                    </Grid>
                </Expander.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="Existing Name:" VerticalAlignment="Center" Foreground="White" Width="100" />
                            <TextBox Width="200" x:Name="ExistingRuleName" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="IP Addresses: " Foreground="White" Width="100" />
                            <TextBox x:Name="ExistingIps"  Width="200" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Save Rule" VerticalAlignment="Top" Margin="526,103,0,0" Width="110" Grid.ColumnSpan="2" Click="SaveRule_Click" />
                    <Button Grid.Column="0" Content="Delete Rule" VerticalAlignment="Top" Margin="411,103,0,0" Width="110" Click="DeleteRule_Click" />
                </Grid>
            </Expander>

            <TextBlock Text="Discord Related" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

            <ui:CardControl>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Drafts16" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Discord Rich Presence" FontWeight="SemiBold" />
                        <TextBlock Text="Shows on discord what you are playing." Foreground="White" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IsActivityTrackingEnabled}" VerticalAlignment="Center" />
            </ui:CardControl>

        </StackPanel>
    </ScrollViewer>
</Page>
